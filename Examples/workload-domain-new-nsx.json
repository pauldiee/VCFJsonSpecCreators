{
  "domainName": "wld-01",
  "orgName": "rainpole",
  "deployWithoutLicenseKeys": true,
  "dnsServers": [ "192.168.10.5", "192.168.10.6" ],
  "ntpServers": [ "ntp1.vcf.lab", "ntp2.vcf.lab" ],
  "ssoDomainSpec": {
    "ssoDomainName": "vsphere.local",
    "ssoDomainPassword": "<ssoDomainPassword>"
  },
  "vcenterSpec": {
    "name": "vcenter-wld01",
    "datacenterName": "WLD-Datacenter",
    "networkDetailsSpec": {
      "dnsName": "vcenter-wld01.vcf.lab",
